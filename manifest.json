{
  "manifest_version": 3,
  "name": "QuickTab",
  "description": "Fast tab switcher for Chrome",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon_32.png"
    }
  },
  "icons": {
    "32": "icons/icon_32.png",
    "36": "icons/icon_36.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Toggle recent tabs panel"
    }
  }
}
